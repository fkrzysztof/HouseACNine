<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HouseNet9</title>
    <script type="importmap"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    @RenderSection("Styles", required: false)
    <link href="~/lib/fontawesome/css/all.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />

    @* potrzebne do formatowania *@
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HouseNet9</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* ********** Menu *********** ********** Menu *********** ********** Menu *********** ********** Menu *********** *@

@*                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li> *@
@*                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="DescriptionPages" asp-action="Index">DescriptionPages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="DetailedInformations" asp-action="Index">DetailedInformations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Distance" asp-action="Index">Distance</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="GeneralInformations" asp-action="Index">GeneralInformations</a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="RentalClients" asp-action="Index">RentalClients ALL</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Houses" asp-action="Index">Houses</a>
                        </li>
@*                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Contacts" asp-action="Index">Contact</a>
                        </li> *@


                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>




                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">


        @{
            var controllerNow = ViewContext.RouteData.Values["controller"]?.ToString();
            var actionNow = ViewContext.RouteData.Values["action"]?.ToString();

            var houseIdFromSession = Context.Session.GetInt32("CurrentHouseId") ?? 0;
            var houseNameFromSession = Context.Session.GetString("CurrentHouseName") ?? "Nie wybrano domu";
        }

        @if (controllerNow == "DescriptionPages" ||
                controllerNow == "DetailedInformations" ||
                controllerNow == "Distance" ||
                controllerNow == "GeneralInformations" ||
                controllerNow == "RentalClients" ||
                controllerNow == "RentalPrices" ||
                controllerNow == "Contacts" ||
                controllerNow == "RentalHouse" ||
                controllerNow == "HouseSettings" ||
                (controllerNow == "Houses" && actionNow == "Edit"))
        {
            <div class="row">
                <div class="col-12">
                    <h5>Edycja domu: @houseNameFromSession</h5>
                    @await Component.InvokeAsync("HouseTabs", new { houseId = houseIdFromSession })

                </div>
                @if((actionNow != "Edit" && controllerNow != "Houses") &&
                            (actionNow != "Index" && controllerNow != "DescriptionPages") &&
                            (actionNow != "Index" && controllerNow != "DetailedInformations") &&
                            (actionNow != "Index" && controllerNow != "Distance") &&
                            (actionNow != "Index" && controllerNow != "GeneralInformations") &&
                            (actionNow != "Index" && controllerNow != "RentalHouse") &&
                            (actionNow != "Index" && controllerNow != "RentalPrices") &&
                            (actionNow != "Index" && controllerNow != "Contacts") &&
                            (actionNow != "Details" && controllerNow != "HouseSettings")
                )
            {
                    <div class="col-12">
                    <a asp-action="Index" >powrót</a>
                    </div>
                }
            </div>
        }


        @*  <main role="main" class="pb-3"> *@
        @RenderBody()
        @*  </main> *@
    </div>
@* 
    @await Component.InvokeAsync("ContactFooter")
 *@
    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2025 - HouseNet9 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>





    <script src="~/libnew/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)



</body>
</html>
