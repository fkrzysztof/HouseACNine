    <style>



            .house-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding: 0;
            list-style: none;
        }

        .house-tabs .tab {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 999px;
            background: #f1f3f5;
            color: #555;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .house-tabs .tab:hover {
            background: #e2e6ea;
            color: #000;
        }

        .house-tabs .tab.active {
            background: #0d6efd;
            color: #fff;
            box-shadow: 0 4px 10px rgba(13,110,253,0.3);
        }

      @*       scroll tabs *@

            .house-tabs-wrapper {
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .house-tabs {
        flex-wrap: nowrap;
    }

    </style>



@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="house-tabs-wrapper mb-4">
    <ul class="nav house-tabs">

        <li>
            <a class="tab @(controllerName == "Houses" ? "active" : "")"
               asp-controller="Houses" asp-action="Edit">
                🏠 Info
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "DescriptionPages" ? "active" : "")"
               asp-controller="DescriptionPages" asp-action="Index">
                📄 Sekcje
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "DetailedInformations" ? "active" : "")"
               asp-controller="DetailedInformations" asp-action="Index">
                📋 Szczegóły
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "Distance" ? "active" : "")"
               asp-controller="Distance" asp-action="Index">
                📍 Odległości
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "GeneralInformations" ? "active" : "")"
               asp-controller="GeneralInformations" asp-action="Index">
                ⭐ Udogodnienia
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "RentalHouse" ? "active" : "")"
               asp-controller="RentalHouse" asp-action="Index">
                📅 Rezerwacje
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "RentalPrices" ? "active" : "")"
               asp-controller="RentalPrices" asp-action="Index">
                💰 Ceny
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "Contacts" ? "active" : "")"
               asp-controller="Contacts" asp-action="Index">
                📞 Kontakt
            </a>
        </li>

        <li>
            <a class="tab @(controllerName == "HouseSettings" ? "active" : "")"
               asp-controller="HouseSettings" asp-action="Details">
                ⚙️ Ustawienia
            </a>
        </li>

    </ul>
</div>

