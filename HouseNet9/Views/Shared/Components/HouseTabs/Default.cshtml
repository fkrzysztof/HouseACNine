@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var houseId = (int)ViewBag.HouseId;
}

<ul class="nav nav-tabs mb-4">

    <li class="nav-item">
        <a class="nav-link @(controllerName == "Houses" ? "active" : "")"
           asp-controller="Houses"
           asp-action="Edit"
           asp-route-id="@houseId">
            Główne Info
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(controllerName == "DescriptionPages" ? "active" : "")"
           asp-controller="DescriptionPages"
           asp-action="Index"
           asp-route-houseId="@houseId">
            Sekcje
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(controllerName == "DetailedInformations" ? "active" : "")"
           asp-controller="DetailedInformations"
           asp-action="Index"
           asp-route-houseId="@houseId">
            Pomieszczenia/Szczegóły
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(controllerName == "Distance" ? "active" : "")"
           asp-controller="Distance"
           asp-action="Index"
           asp-route-houseId="@houseId">
            Odległości
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(controllerName == "GeneralInformations" ? "active" : "")"
           asp-controller="GeneralInformations"
           asp-action="Index"
           asp-route-houseId="@houseId">
            Wyposażenie
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(controllerName == "RentalClients" ? "active" : "")"
           asp-controller="RentalClients"
           asp-action="Index"
           asp-route-houseId="@houseId">
            Rezerwacje tego obiektu
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(controllerName == "RentalPrices" ? "active" : "")"
           asp-controller="RentalPrices"
           asp-action="Index"
           asp-route-houseId="@houseId">
            Ceny
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(controllerName == "Contacts" ? "active" : "")"
           asp-controller="Contacts"
           asp-action="Index"
           asp-route-houseId="@houseId">
            Kontakt
        </a>
    </li>

</ul>

