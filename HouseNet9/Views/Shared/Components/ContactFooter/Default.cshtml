@using HouseNet9.ViewModels
@using WeatherModule.Core.Helpers
@model ContactFooterVM




@* ********************************** Formularz kontaktowy ********************************** *@
<section class="signup-section before-footer" id="signup">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-10 col-lg-8 mx-auto text-center">
                <i class="far fa-paper-plane fa-2x mb-2 text-white"></i>
                <h2 class="text-white mb-5">Skontaktuj się z nami</h2>

                <form asp-controller="Home" asp-action="SendEmail" method="post" class="form-signup">
                    @Html.AntiForgeryToken()

                    @* Alert dla formularza *@
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success text-center">
                            @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger text-center">
                            @TempData["Error"]
                        </div>
                    }

                    <div class="row input-group-newsletter">

                        <div class="col-md-6 my-2" data-aos-delay="200" data-aos="fade-left">
                            <input asp-for="Form.Name" class="form-control" placeholder="Imię" />
                            <span asp-validation-for="Form.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6" data-aos-delay="250" data-aos="fade-right">
                            <input asp-for="Form.Email" class="form-control" placeholder="Email" />
                            <span asp-validation-for="Form.Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 my-2" data-aos-delay="250" data-aos="fade-left">
                            <textarea asp-for="Form.Message" class="form-control" placeholder="Wiadomość" style="height:200px;"></textarea>
                            <span asp-validation-for="Form.Message" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-3" data-aos-delay="300" data-aos="fade-right">
                            <button class="btn btn-primary w-100" type="submit">Wyślij</button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</section>


<footer class="footer-custom">

    <div class="container py-5">

        <div class="row gy-5">

            <!-- BRAND -->
            <div class="col-lg-3">

                <img src="~/uploads/@ViewBag.Logo" class="footer-logo" data-aos-delay="200" data-aos="fade-up" />

                <p class="footer-description">
                    Nowoczesny dom wakacyjny z intuicyjnym systemem rezerwacji online.
                    Komfort, prywatność i szybka dostępność terminów.
                </p>

                <img src="/Qr/FooterQr" alt="QR Code" width="120" data-aos-delay="200" data-aos="flip-left" />

            </div>

            <!-- CONTACT -->
            <div class="col-lg-3  text-center text-lg-start" data-aos-delay="200" data-aos="fade-up">

                <h5 class="mb-4">Kontakt</h5>

                @if (Model.Contacts?.Any() == true)
                {
                    foreach (var contact in Model.Contacts)
                    {
                        <div class="footer-contact-box mb-4">

                            <div class="fw-bold mb-2">@contact.Name</div>

                            @if (contact.Addresses?.Any() == true)
                            {
                                var addr = contact.Addresses.First();

                                <div class="small text-muted mb-2">
                                    @addr.Street<br />
                                    @addr.PostalCode @addr.City<br />
                                    @addr.Country
                                </div>
                            }

                            @if (contact.EmailAddresses?.Any() == true)
                            {
                                <a class="footer-link d-block"
                                   href="mailto:@contact.EmailAddresses.First().Email">
                                    @contact.EmailAddresses.First().Email
                                </a>
                            }

                            @if (contact.PhoneNumbers?.Any() == true)
                            {
                                <a class="footer-link d-block"
                                   href="tel:@contact.PhoneNumbers.First().Number">
                                    @contact.PhoneNumbers.First().Number
                                </a>
                            }

                        </div>
                    }
                }
                else
                {
                    <p class="small text-muted">Brak danych kontaktowych.</p>
                }

            </div>

            <!-- LINKS -->
            <div class="col-lg-3 text-center text-lg-start" data-aos-delay="200" data-aos="fade-up">

                <h5 class="mb-4">Informacje</h5>

                <div class="footer-links">

                    <a href="#">
                        Polityka prywatności
                    </a>

                    <a href="#">
                        Cookies
                    </a>
                    <!--  Linki generowane-->
                    @{
                        if (ViewBag.MenuItems != null)
                        {
                            List<string> footermeuItems = ViewBag.MenuItems as List<string>;
                            foreach (string item in footermeuItems)
                            {
                                <a href="#@item">@item</a>

                            }
                        }
                    }

                    <a href="#commentanchor">Opinie klientów</a>
                    <a href="#detailedanchor">Wyposażenie</a>
                    <a href="#distanceanchor">Odległości</a>
                </div>

            </div>

            <!-- CTA -->
            <div class="col-lg-3" data-aos-delay="200" data-aos="fade-up">

                <div class="footer-cta mt-5 mt-lg-0">

                    <h5 class="mb-3">Rezerwacja</h5>

                    <p class="mb-4">
                        Sprawdź dostępność i zarezerwuj pobyt w kilka sekund.
                    </p>

                    <a href="#calendaranchor"
                       class="btn btn-light w-100 rounded-pill">
                        Otwórz kalendarz
                    </a>

                    <div class="mt-3 small opacity-75">
                        ✓ Aktualna dostępność<br />
                        ✓ Natychmiastowa rezerwacja<br />
                        ✓ Potwierdzenie online
                    </div>

                    <!-- WEATHER -->
                    @if (Model.Weather != null)
                    {
                        <div class="weather-card mt-3">

                            <div class="d-flex justify-content-between">
                                <div>
                                    <div>Pogoda</div>
                                    <div class="fw-bold">@Model.Weather.Temperature °C</div>
                                </div>

                                <i class="bi @WeatherIconHelper.GetIcon(Model.Weather.WeatherCode) fs-2"></i>
                            </div>

                            <div class="small opacity-75">
                                Wiatr: @Model.Weather.WindSpeed km/h
                            </div>

                        </div>
                    }


                </div>

            </div>

        </div>

        <!-- BOTTOM -->
        <div class="footer-bottom mt-5 pt-4" data-aos-delay="300" data-aos="zoom-in">

            <div class="d-flex justify-content-between flex-wrap gap-3">

                <span>© 2006 RH</span>

                <div>
                    <a href="/Privacy" class="me-3">Polityka prywatności</a>
                    <a href="#calendaranchor">Rezerwacja</a>
                </div>

            </div>

        </div>

    </div>

    <button id="backToTop" class="back-to-top">
        <i class="bi bi-chevron-up"></i>
    </button>

</footer>