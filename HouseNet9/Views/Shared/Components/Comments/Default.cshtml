 @model List<Data.Data.HouseRentalData.Comment>


<section>
    <div class="container my-5" id="commentanchor">


        <!-- OVERLAY (na wideo) -->
        <div class="rating-box rating-overlay" id="ratingOverlay">

            <div class="rating-number">
                @ViewBag.AvgRating.ToString("0.0")
            </div>

            <div class="stars">
                @{
                    var rating = (double)ViewBag.AvgRating;
                    var full = (int)Math.Floor(rating);
                    var half = rating - full >= 0.5;
                }

                @for (int i = 0; i < full; i++)
                {
                    <span class="star full">★</span>
                }

                @if (half)
                {
                    <span class="star half">★</span>
                }

                @for (int i = full + (half ? 1 : 0); i < 5; i++)
                {
                    <span class="star empty">★</span>
                }
            </div>

            <div class="count">
                (@ViewBag.TotalComments opinii)
            </div>

            <span class="badge bg-success">@ViewBag.RatingLabel</span>

        </div>


        <!-- NORMALNE MIEJSCE (pod sekcją / tam gdzie ma wrócić) -->
        <div class="rating-box rating-inline hidden" id="ratingInline">

            <div class="rating-number">
                @ViewBag.AvgRating.ToString("0.0")
            </div>

            <div class="stars">
                @{
                    // var rating = (double)ViewBag.AvgRating;
                    // var full = (int)Math.Floor(rating);
                    // var half = rating - full >= 0.5;
                }

                @for (int i = 0; i < full; i++)
                {
                    <span class="star full">★</span>
                }

                @if (half)
                {
                    <span class="star half">★</span>
                }

                @for (int i = full + (half ? 1 : 0); i < 5; i++)
                {
                    <span class="star empty">★</span>
                }
            </div>

            <div class="count">
                (@ViewBag.TotalComments opinii)
            </div>

            <span class="badge bg-success">@ViewBag.RatingLabel</span>

        </div>

        <h2 class="section-divider">
            <span>Opinie klientów</span>
        </h2>

        <div>
            @await Html.PartialAsync("_CommentsList", Model)
        </div>
    </div>
</section>