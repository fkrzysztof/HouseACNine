@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var alwaysWWWControllers = new[] { "Home", "GetCalendar" };

    if (!alwaysWWWControllers.Contains(controller, StringComparer.OrdinalIgnoreCase))
    {
        Layout = "_LayoutEdit"; // wszystkie inne strony mają layout edit
    }
    else
    {
        Layout = "_LayoutWWW"; // Home i GetCalendar zawsze layout www
    }
}