@model List<Data.Data.HouseRentalData.Comment>

<div class="row g-4"  id="commentsContainer">
    @foreach (var comment in Model)
    {
        <div class="col-12 col-md-6 col-lg-4 comment-item" style="opacity:0; transform: translateY(20px); transition: all 0.4s;">
            <div class="card shadow-sm h-100 border-0 comment-card">
                <div class="card-body d-flex flex-column align-content-between">
                    <h5 class="d-flex justify-content-between align-items-center">
                        <span>@comment.AuthorName</span>
                        @if (!string.IsNullOrEmpty(comment.CountryCode))
                        {
                            <img src="@( "https://flagcdn.com/24x18/" + comment.CountryCode.ToLower() + ".png" )"
                                 alt="@comment.CountryCode"
                                 title="@comment.CountryCode"
                                 style="width:24px; height:18px;" />
                        }
                    </h5>

                    <div class="text-warning mb-2">
                        @for (int i = 0; i < comment.Rating; i++)
                        {
                            <span>★</span>
                        }
                    </div>

                    <p class="flex-grow-1">@comment.Text</p>

                    <small class="text-muted">@comment.CreatedAt.ToShortDateString()</small>

                    @if (!string.IsNullOrEmpty(comment.AdminText))
                    {
                        <div class="mt-3 p-2 bg-light rounded">
                            <strong>Odpowiedź:</strong>
                            <p class="mb-0">@comment.AdminText</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
