<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Rental</title>
    <link rel="icon" type="image/x-icon" href="~/layout/assets/favicon.ico" />

    @* Icons *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">


    <!-- Font -->
    
    <!-- Font Awesome icons (free version)-->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <!-- Google fonts-->
    <link href="https://fonts.googleapis.com/css?family=Varela+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Corinthia:wght@400;700&display=swap" rel="stylesheet">

    @RenderSection("Styles", required: false)

    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="~/layout/css/styles.css" rel="stylesheet" asp-append-version="true" />

    <script type="importmap"></script>
    <link href="~/css/over-css.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/calendarOnly.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/comments.css" rel="stylesheet" asp-append-version="true" />


</head>
<body id="page-top">
    <!-- Navigation-->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top" id="mainNav">
        <div class="container px-4 px-lg-0">
       


            @* Logo *@
            <a class="navbar-brand" href="#page-top">
                <img src="~/uploads/@ViewBag.Logo" class="navbar-brand" style="height:72px;" />
            </a>


            <button class="navbar-toggler custom-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarResponsive"
                    aria-controls="navbarResponsive"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span></span>
                <span></span>
                <span></span>

            </button>


            <div class="collapse navbar-collapse" id="navbarResponsive">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="GeneralInformations" asp-action="Index">Rezerwacja ONLINE</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Szczegóły
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">

                    @{
                        if (ViewBag.MenuItems != null)
                        {
                            List<string> meuItems = ViewBag.MenuItems as List<string>;
                            foreach (string item in meuItems)
                            {
                                <li>
                                    <a href="#@item" class="dropdown-item">@item</a>
                                </li>
                            }
                        }
                    }

                            <li><hr class="dropdown-divider" /></li>

                            <li><h6 class="dropdown-header">Informacje</h6></li>

                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="DetailedInformations" asp-action="Index">Wyposażenie</a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Distance" asp-action="Index">Odległości</a>
                            </li>

                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Contacts" asp-action="Index">Kontakt</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="video-wrapper">
        <video autoplay muted loop playsinline class="video-bg">
            <source src="~/video/compressed_1211.webm" type="audio/webm" />
        </video>

        <!-- tutaj twoja treść na wideo -->
        <div class="content container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
            <div class="d-flex justify-content-center">
                <div class="text-center">


                    <img src="~/layout/assets/img/logo.png" style="height: 32rem;" />
                        @* <h1 class="mx-auto my-0 text-uppercase">KING'S REST</h1> *@

                        @* Short txt *@
                    <h2 class="text-white mx-auto mt-2 mb-5" style="font-family:Corinthia;">@ViewBag.HouseName</h2>
                  
                    <a class="btn btn-primary" href="#calendaranchor">Zarezerwuj teraz</a>
                </div>
            </div>
        </div>

        <div id="language-selector" class="visible">
            <button class="lang-btn">PL</button>
            <button class="lang-btn">DE</button>
            <button class="lang-btn">EN</button>
        </div>

    </div>

    <div class="container-fluid px-0">
        @RenderBody()
    </div>

    <section>
        <iframe src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d2899.678461979676!2d16.516465084166974!3d43.38374679535635!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zNDPCsDIzJzAxLjUiTiAxNsKwMzEnMTYuOCJF!5e0!3m2!1spl!2spl!4v1754076848492!5m2!1spl!2spl" style="border:0; width:100%; height:400px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>

    @{
        int? IdHouse = ViewBag.IdHouse;
    }

    @if (IdHouse != null)
    {
        //comment
        //section con/row/div
        @await Component.InvokeAsync("Comments", new { houseId = IdHouse, count = 6 })
        //button load
        <div class="container my-5">
            <div class="row">
                <div class="col-12 text-center">
                    <button id="loadMoreBtn"
                            data-house="@IdHouse"
                            class="btn btn-primary mt-3">

                        <span class="btn-text">Załaduj więcej komentarzy</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>

                    </button>
                </div>
            </div>
        </div>

        //footer
        //section con/row/div
        @await Component.InvokeAsync("ContactFooter", new { id = IdHouse })
      @*   @await Component.InvokeAsync("ContactFooter", new { id = IdHouse, lat = 50.01, lon = 20.99 }) *@
    }


    <script src="~/js/comment.js" asp-append-version="true"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/libnew/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/layout/js/scripts.js"></script>
    <script src="~/js/ratingbox.js"></script>
    <script src="~/js/backtotop.js"></script>
    <script src="~/js/menu.js"></script>

    @await RenderSectionAsync("Scripts", required: false)



</body>
</html>
