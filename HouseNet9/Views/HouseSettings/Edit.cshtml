@model Data.Data.HouseRentalData.HouseSettings
@{
    ViewBag.Title = "Edytuj ustawienia domu";
    // var houseId = ViewBag.HouseId;
}
@section Scripts {
    <script src="~/js/imagepreview.js"></script>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    @if (Model.IsDefault)
    {
        <h4 class="mb-0">Edytuj ustawienia domyślne</h4>
    }
    else
    {
        <h4 class="mb-0">Edytuj ustawienia indywidualne obiektu</h4>
    }
  </div>

<form asp-action="Edit" asp-controller="HouseSettings" method="post" enctype="multipart/form-data">
    @* <input type="hidden" name="houseId" value="@houseId" /> *@
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Procent zadatku (%)</label>
        <input asp-for="DepositPercentage" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dni na wpłatę zadatku</label>
        <input asp-for="DepositDueDays" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dni przed przyjazdem na wpłatę pełnej kwoty</label>
        <input asp-for="FullPaymentDueDaysBeforeArrival" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Waluta</label>
        <input asp-for="Currency" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Numer konta IBAN</label>
        <input asp-for="BankAccountIban" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">SWIFT</label>
        <input asp-for="BankAccountSwift" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nazwa właściciela konta</label>
        <input asp-for="BankAccountName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nazwa banku</label>
        <input asp-for="BankName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Logo domu (plik)</label>
        <input type="hidden" asp-for="LogoFileName" />
        <input type="file" id="fileInput" name="logoFile" class="form-control" />
        @{
            var logoPath = !string.IsNullOrEmpty(Model.LogoFileName)
            ? Url.Content("~/uploads/" + Model.LogoFileName)
            : Url.Content("~/images/no_photography_24dp.svg");
        }
        <img src="@logoPath" id="preview" alt="Logo" style="height:50px;" />
    </div>

    <input type="hidden" asp-for="IsDefault" />

    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
</form>