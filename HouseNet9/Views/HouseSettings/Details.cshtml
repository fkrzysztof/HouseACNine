@model Data.Data.HouseRentalData.HouseSettings
@{
    ViewBag.Title = "Szczegóły ustawień domu";
    var houseId = ViewBag.HouseId;
}

<div class="d-flex justify-content-between align-items-center mb-4">


    @if (Model.IsDefault)
    {
        <h4 class="mb-0">Ten obiekt korzysta z ustawien domyślnych</h4>

        <br />
        <a asp-action="Create" asp-route-houseId="@houseId" class="btn btn-primary">
            Nadaj indywidualne ustawienia
        </a>
    }
    else
    {
        <h4 class="mb-0">Ten obiekt ma indywidualne ustawienia</h4>

        <br />
        <h3 class="mb-0">Szczegóły ustawień</h3>
        <a asp-action="RevertToDefault" asp-route-houseId="@houseId" class="btn btn-primary">
            Przywróć domyślne ustawienia
        </a>
    }

</div>

<div class="row">
    <div class="col-6">



        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>Procent zadatku:</strong> @Model.DepositPercentage %
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>Dni na wpłatę zadatku:</strong> @Model.DepositDueDays
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>Dni przed przyjazdem na wpłatę pełnej kwoty:</strong> @Model.FullPaymentDueDaysBeforeArrival
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>Waluta:</strong> @Model.Currency
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>IBAN:</strong> @Model.BankAccountIban
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>SWIFT:</strong> @Model.BankAccountSwift
            </div>
        </div>


        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>Właściciel:</strong> @Model.BankAccountName
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>Nazwa banku:</strong> @Model.BankName
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <strong>Logo domu:</strong>
                @{
                    var logoPath = !string.IsNullOrEmpty(Model.LogoFileName)
                    ? Url.Content("~/uploads/" + Model.LogoFileName)
                    : Url.Content("~/images/no_photography_24dp.svg");
                }
                <img src="@logoPath" alt="Logo" class="img-fluid mt-2" style="max-height:100px;" />
            </div>
        </div>

        <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-houseId="@houseId" class="btn btn-warning">Edytuj ustawienia domyślne</a>
       
    </div>
</div>