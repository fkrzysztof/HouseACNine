@model IEnumerable<Data.Data.HouseRentalData.HouseSettings>

@{
    ViewData["Title"] = "Ustawienia";
}

<h1>Ustawienia domów</h1>

<p>
    <a class="btn btn-primary" asp-action="Create" asp-route-houseId="0">Dodaj nowe ustawienia</a>
</p>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Domyślne</th>
            <th>Logo</th>
            <th>% Zaliczki</th>
            <th>Dni na zaliczkę</th>
            <th>Dni do pełnej płatności</th>
            <th>Waluta</th>
            <th>Numer konta IBAN</th>
            <th>SWIFT</th>
            <th>Nazwa konta</th>
            <th>Nazwa banku</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>
                    @if (s.IsDefault)
                    {
                        <span class="badge bg-success">Tak</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Nie</span>
                    }
                </td>
                <td>
                    @{
                        var logoPath = !string.IsNullOrEmpty(s.LogoFileName)
                        ? Url.Content("~/uploads/" + s.LogoFileName)
                        : Url.Content("~/images/no_photography_24dp.svg");
                    }
                    <img src="@logoPath" alt="Logo" style="height:50px;" />
                </td>
                <td>@s.DepositPercentage %</td>
                <td>@s.DepositDueDays</td>
                <td>@s.FullPaymentDueDaysBeforeArrival</td>
                <td>@s.Currency</td>
                <td>@s.BankAccountIban</td>
                <td>@s.BankAccountSwift</td>
                <td>@s.BankAccountName</td>
                <td>@s.BankName</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-houseId="@s.Id">Szczegóły</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@s.Id" asp-route-houseId="0">Edytuj</a>
                    @if (!s.IsDefault)
                    {
                        <a class="btn btn-sm btn-success" asp-action="SetDefault" asp-route-id="@s.Id">Ustaw jako domyślne</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>