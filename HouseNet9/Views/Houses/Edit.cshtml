@model Data.Data.HouseRentalData.House

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section scripts {
    <script src="~/js/quilltextformatting.js"></script>
}



<h1>Edit</h1>

<h4>House</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="HouseId" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ShortText" class="control-label"></label>
                <input asp-for="ShortText" class="form-control" />
                <span asp-validation-for="ShortText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LongText" class="control-label"></label>
                <input asp-for="LongText" class="form-control" />
                <span asp-validation-for="LongText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RentalRules" class="control-label"></label>

                <div id="quillEditor" style="height: 400px; background-color: #fff; border: 1px solid #ccc;">
                    @Html.Raw(Model.RentalRules)
                </div>

                <input type="hidden" name="RentalRules" />

                <span asp-validation-for="RentalRules" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>




            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

