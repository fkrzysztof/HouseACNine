
@*   bootstrap 5 *@


@model Data.Data.HouseRentalData.House

@section Scripts {
    <script src="~/js/quilltextformatting.js"></script>
}

<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="HouseId" />

            <!-- Nazwa -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Tekst krótki -->
            <div class="mb-3">
                <label asp-for="ShortText" class="form-label"></label>
                <input asp-for="ShortText" class="form-control" />
                <span asp-validation-for="ShortText" class="text-danger"></span>
            </div>

            <!-- Tekst długi -->
            <div class="mb-3">
                <label asp-for="LongText" class="form-label"></label>
                <input asp-for="LongText" class="form-control" />
                <span asp-validation-for="LongText" class="text-danger"></span>
            </div>

            <!-- Zasady wynajmu -->
            <div class="mb-3">
                <label asp-for="RentalRules" class="form-label"></label>
                <div id="quillEditor" style="height: 400px; background-color: #fff; border: 1px solid #ccc;">
                    @Html.Raw(Model.RentalRules)
                </div>
                <input type="hidden" name="RentalRules" />
                <span asp-validation-for="RentalRules" class="text-danger"></span>
            </div>

            <!-- Checkbox IsActive -->
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="IsActive" />
                <label class="form-check-label" for="IsActive">@Html.DisplayNameFor(model => model.IsActive)</label>
            </div>

            <!-- Submit -->
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
