@model IEnumerable<Data.Data.HouseRentalData.House>

<p>
    <a asp-action="Create">Dodaj</a>
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-lg-6">
            <div class="card m-2">
                <div class="card-body">
                    <span>@Html.DisplayFor(modelItem => item.Name)</span><span class="float-end">
                        <a class="nav-link" asp-action="Edit" asp-route-id="@item.HouseId"><img src="~/uploads/edit_square_24.svg" class="edit-options" /></a>
                    </span>
                </div>
            </div>
        </div>
    }
</div>