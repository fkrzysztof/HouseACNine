@model IEnumerable<Data.Data.HouseRentalData.House>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Obiekty</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Dodaj
    </a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-lg-6">
            <div class="card m-2">
                <div class="card-body">
                    <span>@Html.DisplayFor(modelItem => item.Name)</span><span class="float-end">
                        <a class="nav-link" asp-action="Edit" asp-route-id="@item.HouseId"><img src="~/uploads/edit_square_24.svg" class="edit-options" /></a>
                    </span>
                </div>
            </div>
        </div>
    }
</div>