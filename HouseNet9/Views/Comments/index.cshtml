<h2>Dodaj opinię</h2>

<form method="post" autocomplete="off">
    <input name="reservationCode"
           class="form-control mb-2"
           placeholder="Kod rezerwacji"
           autocomplete="new-password" />

    <input name="email"
           class="form-control mb-2"
           placeholder="Email"
           autocomplete="new-password" />

    <button class="btn btn-dark">Dalej</button>
</form>