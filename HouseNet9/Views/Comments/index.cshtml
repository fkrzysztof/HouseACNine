@{
    Layout = "~/Views/Shared/_LayoutComments.cshtml";
}
<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card shadow-lg border-0 p-4" style="max-width: 420px; width: 100%; border-radius: 16px;">

        <h2 class="text-center mb-4">Dodaj opinię</h2>
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form method="post" autocomplete="off">

            <input name="reservationCode"
                   class="form-control mb-3"
                   placeholder="Kod rezerwacji"
                   autocomplete="new-password" />

            <input name="email"
                   class="form-control mb-3"
                   placeholder="Email"
                   autocomplete="new-password" />

            <button class="btn btn-dark w-100">
                Dalej
            </button>

        </form>

    </div>

</div>