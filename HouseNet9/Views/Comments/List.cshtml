@model List<Data.Data.HouseRentalData.Comment>

<h2>Komentarze (Panel Admina)</h2>

<!-- FILTRY -->
<div class="mb-3 d-flex flex-wrap gap-2">
    <a asp-action="List" class="btn btn-secondary btn-sm">Wszystkie</a>
    <a asp-action="List" asp-route-approved="true" class="btn btn-success btn-sm">Zatwierdzone</a>
    <a asp-action="List" asp-route-approved="false" class="btn btn-warning btn-sm">Do moderacji</a>
</div>

<!-- ================= DESKTOP TABLE ================= -->
<table class="table table-striped table-hover d-none d-md-table">
    <thead>
        <tr>
            <th>Autor</th>
            <th>Email</th>
            <th>Ocena</th>
            <th>Treść</th>
            <th>Data</th>
            <th>Status</th>
            <th>Akcje</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.AuthorName</td>
                <td>@c.Email</td>
                <td>@c.Rating ⭐</td>
                <td style="max-width:300px">
                    @(c.Text.Length > 120 ? c.Text.Substring(0, 120) + "..." : c.Text)
                </td>
                <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (c.IsApproved)
                    {
                        <span class="badge bg-success">OK</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Do sprawdzenia</span>
                    }
                </td>

                <td class="d-flex gap-1">

@*                     @if (!c.IsApproved)
                    { *@
                        <form asp-action="Approve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                            <input type="hidden" name="approved" value="@ViewBag.Approved" />
                        <button class="btn btn-success btn-sm" @(c.IsApproved == true ? "disabled" : "") title="Akceptuj"><i class="bi bi-check2"></i></button>
                        </form>
                   @*  } *@

                    <a asp-action="Moderate"
                       asp-route-id="@c.Id"
                       class="btn btn-dark btn-sm">
                        Edytuj
                    </a>

                    <form asp-action="Delete" method="post"
                          onsubmit="return confirm('Na pewno usunąć?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                        <input type="hidden" name="approved" value="@ViewBag.Approved" />
                        <button class="btn btn-danger btn-sm" title="Usuń"><i class="bi bi-x-lg"></i></button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ================= MOBILE CARDS ================= -->
<div class="d-md-none">

    @foreach (var c in Model)
    {
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <strong>@c.AuthorName</strong>
                    <span>@c.Rating ⭐</span>
                </div>

                <div class="text-muted small">
                    @c.Email
                </div>

                <div class="mt-2">
                    @(c.Text.Length > 120 ? c.Text.Substring(0, 120) + "..." : c.Text)
                </div>

                <div class="mt-2 small text-muted">
                    @c.CreatedAt.ToString("yyyy-MM-dd")
                </div>

                <div class="mt-2">
                    @if (c.IsApproved)
                    {
                        <span class="badge bg-success">OK</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Do sprawdzenia</span>
                    }
                </div>

                <div class="mt-3 d-flex flex-column gap-2">

                    @if (!c.IsApproved)
                    {
                        <form asp-action="Approve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                            <input type="hidden" name="approved" value="@ViewBag.Approved" />
                            <button class="btn btn-success btn-sm w-100">✔ Akceptuj</button>
                        </form>
                    }

                    <a asp-action="Moderate"
                       asp-route-id="@c.Id"
                       class="btn btn-dark btn-sm w-100">
                        Edytuj
                    </a>

                    <form asp-action="Delete" method="post"
                          onsubmit="return confirm('Na pewno usunąć?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                        <input type="hidden" name="approved" value="@ViewBag.Approved" />
                        <button class="btn btn-danger btn-sm w-100">Usuń</button>
                    </form>

                </div>

            </div>
        </div>
    }

</div>

<!-- ================= PAGINATION ================= -->
@if (ViewBag.TotalPages > 1)
{
    <p class="text-center">
        Strona @ViewBag.CurrentPage z @ViewBag.TotalPages
    </p>
}

<nav>
    <ul class="pagination justify-content-center flex-wrap">

        @if (ViewBag.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="List"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-approved="@ViewBag.Approved">
                    «
                </a>
            </li>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="List"
                   asp-route-page="@i"
                   asp-route-approved="@ViewBag.Approved">
                    @i
                </a>
            </li>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="List"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-approved="@ViewBag.Approved">
                    »
                </a>
            </li>
        }

    </ul>
</nav>