@{
    Layout = "~/Views/Shared/_LayoutComments.cshtml";

    var title = TempData["Title"] as string ?? "Dziękujemy!";
    var message = TempData["Message"] as string ?? "Operacja zakończona pomyślnie.";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card shadow-lg border-0 p-4" style="max-width: 420px; width: 100%; border-radius: 16px;">

        <h2 class="mb-3">@title</h2>

        <p class="text-muted">
            @message
        </p>

    </div>
</div>