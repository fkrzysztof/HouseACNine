@model Data.Data.HouseRentalData.Comment

<h3>Twoja opinia</h3>

<!-- Wyświetlamy info o pobycie i autorze -->
<div class="mb-3">
    <p><strong>Autor:</strong> @Model.AuthorName</p>
    <p><strong>Pobyt:</strong> @Model.StayFrom.ToString("MMMM yyyy")</p>
</div>

<form method="post">
    <!-- Ukryte pola potrzebne do bindowania -->
    <input type="hidden" asp-for="HouseId" />
    <input type="hidden" asp-for="ReservationCode" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="StayFrom" />
    <input type="hidden" asp-for="AuthorName" />

    <div class="mb-3">
        <label class="form-label">Ocena</label>
        <div id="star-container">
            @for (int i = 1; i <= 4; i++)
            {
                <span class="star" data-value="@i">★</span>
            }
        </div>
        <input type="hidden" asp-for="Rating" id="Rating" />
    </div>

    <style>
        #star-container {
            display: inline-block;
            cursor: pointer;
        }

        .star {
            font-size: 1.5rem;
            color: #ddd;
            transition: color 0.2s;
            user-select: none;
        }

            .star.hover, .star.selected {
                color: gold;
            }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const stars = document.querySelectorAll('#star-container .star');
            const ratingInput = document.getElementById('Rating');
            let selectedRating = 0;

            stars.forEach((star, idx) => {
                // Hover
                star.addEventListener('mouseover', () => {
                    stars.forEach((s, i) => {
                        s.classList.toggle('hover', i <= idx);
                    });
                });
                star.addEventListener('mouseout', () => {
                    stars.forEach((s, i) => {
                        s.classList.toggle('hover', false);
                    });
                });

                // Click
                star.addEventListener('click', () => {
                    selectedRating = idx + 1;
                    ratingInput.value = selectedRating;
                    stars.forEach((s, i) => {
                        s.classList.toggle('selected', i < selectedRating);
                    });
                });
            });
        });
    </script>

    <div class="mb-3">
        <textarea class="form-control" asp-for="Text" placeholder="Twoja opinia"></textarea>
    </div>

    <button class="btn btn-dark">Wyślij</button>
</form>