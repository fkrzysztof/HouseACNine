@model Data.Data.HouseRentalData.Contact

@section Scripts {
    <script src="~/js/contactnew.js"></script>
}

<div class="row">
    <div class="col-lg-8 col-md-12">

        <div class="card m-2 shadow-sm">

            <form method="post" asp-action="Edit" asp-controller="Contacts">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ContactId" value="@Model.ContactId" />

                <!-- HEADER -->
                <div class="card-header">
                    <input type="text"
                           name="Name"
                           class="form-control form-control-lg"
                           value="@Model.Name" />

                    <button type="submit"
                            name="submitType"
                            value="delete"
                            class="btn btn-danger btn-sm mt-2">
                        Usuń kontakt
                    </button>
                </div>

                <div class="card-body">

                    <!-- ================= -->
                    <!-- ADDRESSES -->
                    <!-- ================= -->
                    <h6>📍 Adresy</h6>

                    <div id="addresses">

                        @foreach (var address in Model.Addresses)
                        {
                            var key = address.AddressId == 0
                            ? Guid.NewGuid().ToString()
                            : address.AddressId.ToString();

                            <div class="removable-item mb-2">

                                <input type="hidden" name="Addresses.Index" value="@key" />

                                <input type="hidden"
                                       name="Addresses[@key].AddressId"
                                       value="@address.AddressId" />

                                <input type="hidden"
                                       name="Addresses[@key].IsHouseAddress"
                                       value="@address.IsHouseAddress" />

                                <input type="text"
                                       name="Addresses[@key].Street"
                                       value="@address.Street"
                                       class="form-control mb-1" />

                                <input type="text"
                                       name="Addresses[@key].PostalCode"
                                       value="@address.PostalCode"
                                       class="form-control mb-1" />

                                <input type="text"
                                       name="Addresses[@key].City"
                                       value="@address.City"
                                       class="form-control mb-1" />

                                <input type="text"
                                       name="Addresses[@key].Country"
                                       value="@address.Country"
                                       class="form-control mb-1" />

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        onclick="removeElement(this)">
                                    Usuń
                                </button>

                            </div>
                        }

                    </div>

                    <button type="button" onclick="addAddress()" class="btn btn-outline-primary btn-sm">
                        + Dodaj adres
                    </button>

                    <hr />

                    <!-- ================= -->
                    <!-- EMAILS -->
                    <!-- ================= -->
                    <h6>📧 E-maile</h6>

                    <div id="emails">

                        @foreach (var email in Model.EmailAddresses)
                        {
                            var key = email.EmailAddressId == 0
                            ? Guid.NewGuid().ToString()
                            : email.EmailAddressId.ToString();

                            <div class="removable-item mb-2">

                                <input type="hidden" name="EmailAddresses.Index" value="@key" />

                                <input type="hidden"
                                       name="EmailAddresses[@key].EmailAddressId"
                                       value="@email.EmailAddressId" />

                                <input type="email"
                                       name="EmailAddresses[@key].Email"
                                       value="@email.Email"
                                       class="form-control d-inline w-75" />

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        onclick="removeElement(this)">
                                    Usuń
                                </button>

                            </div>
                        }

                    </div>

                    <button type="button" onclick="addEmail()" class="btn btn-outline-primary btn-sm">
                        + Dodaj email
                    </button>

                    <hr />

                    <!-- ================= -->
                    <!-- PHONES -->
                    <!-- ================= -->
                    <h6>📞 Telefony</h6>

                    <div id="phones">

                        @foreach (var phone in Model.PhoneNumbers)
                        {
                            var key = phone.PhoneNumberId == 0
                            ? Guid.NewGuid().ToString()
                            : phone.PhoneNumberId.ToString();

                            <div class="removable-item mb-2">

                                <input type="hidden" name="PhoneNumbers.Index" value="@key" />

                                <input type="hidden"
                                       name="PhoneNumbers[@key].PhoneNumberId"
                                       value="@phone.PhoneNumberId" />

                                <input type="text"
                                       name="PhoneNumbers[@key].Number"
                                       value="@phone.Number"
                                       class="form-control d-inline w-75" />

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        onclick="removeElement(this)">
                                    Usuń
                                </button>

                            </div>
                        }

                    </div>

                    <button type="button" onclick="addPhone()" class="btn btn-outline-primary btn-sm">
                        + Dodaj telefon
                    </button>

                    <hr />

                    <!-- SAVE -->
                    <button type="submit"
                            name="submitType"
                            value="save"
                            class="btn btn-success mt-3">
                        💾 Zapisz
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>