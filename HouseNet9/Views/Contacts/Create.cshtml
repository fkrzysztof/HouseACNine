@model Data.Data.HouseRentalData.Contact

@section Scripts {
    <script src="~/js/contactnew.js"></script>
}

<div class="row">
    <div class="col-lg-8 col-md-12">

        <div class="card m-2 shadow-sm">

            <form method="post" asp-action="Create" asp-controller="Contacts">
                @Html.AntiForgeryToken()

                <!-- HEADER -->
                <div class="card-header">
                    <input type="text"
                           name="Name"
                           class="form-control form-control-lg"
                           placeholder="Name" />
                </div>

                <div class="card-body">

                    <!-- ================= -->
                    <!-- ADDRESSES -->
                    <!-- ================= -->
                    <h6>📍 Adresy</h6>

                    <div id="addresses">
                        <!-- dynamiczne elementy JS -->
                    </div>

                    <button type="button"
                            onclick="addAddress()"
                            class="btn btn-outline-primary btn-sm mt-2">
                        + Dodaj adres
                    </button>

                    <hr />

                    <!-- ================= -->
                    <!-- EMAILS -->
                    <!-- ================= -->
                    <h6>📧 E-maile</h6>

                    <div id="emails">
                        <!-- dynamiczne elementy JS -->
                    </div>

                    <button type="button"
                            onclick="addEmail()"
                            class="btn btn-outline-primary btn-sm mt-2">
                        + Dodaj email
                    </button>

                    <hr />

                    <!-- ================= -->
                    <!-- PHONES -->
                    <!-- ================= -->
                    <h6>📞 Telefony</h6>

                    <div id="phones">
                        <!-- dynamiczne elementy JS -->
                    </div>

                    <button type="button"
                            onclick="addPhone()"
                            class="btn btn-outline-primary btn-sm mt-2">
                        + Dodaj telefon
                    </button>

                    <hr />

                    <!-- SAVE -->
                    <button type="submit"
                            class="btn btn-success mt-3">
                        💾 Zapisz kontakt
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>