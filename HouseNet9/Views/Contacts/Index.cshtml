@model IEnumerable<Data.Data.HouseRentalData.Contact>
@using Data.Data.HouseRentalData

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Kontakt</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Dodaj
    </a>
</div>



<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-lg-6 col-md-12">
            <div class="card m-2 shadow-sm">
                
                <!-- Nagłówek z imieniem/nazwiskiem i menu akcji -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i>@item.Name
                    </h5>
                    <div>
                        @await Html.PartialAsync("~/Views/Partial/DetailsMenu.cshtml", item.ContactId)
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body">

                    <!-- Adresy -->
                    @if (item.Addresses?.Any() == true)
                    {
                        <div class="mb-3">
                            <h6 class="fw-bold"><i class="bi bi-geo-alt-fill me-1"></i>Adresy</h6>
                            <ul class="list-group list-group-flush">
                                @foreach (var address in item.Addresses)
                                {
                                    <li class="list-group-item">
                                        <div>@address.Street</div>
                                        <div>@address.PostalCode @address.City</div>
                                        <div>@address.Country</div>

                                        @if (address.IsHouseAddress)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success mt-1"
                                                    disabled>
                                                🏠 Adres obiektu
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="SetHouseAddress" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="contactId" value="@item.ContactId" />
                                                <input type="hidden" name="addressId" value="@address.AddressId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary mt-1">
                                                    🏠 Ustaw jako adres obiektu
                                                </button>
                                            </form>
                                        }

                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- E-maile -->
                    @if (item.EmailAddresses?.Any() == true)
                    {
                        <div class="mb-3">
                            <h6 class="fw-bold"><i class="bi bi-envelope-fill me-1"></i>E-maile</h6>
                            <ul class="list-unstyled">
                                @foreach (var email in item.EmailAddresses)
                                {
                                    <li><i class="bi bi-dot me-1"></i>@email.Email</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Telefony -->
                    @if (item.PhoneNumbers?.Any() == true)
                    {
                        <div>
                            <h6 class="fw-bold"><i class="bi bi-telephone-fill me-1"></i>Telefony</h6>
                            <ul class="list-unstyled">
                                @foreach (var phone in item.PhoneNumbers)
                                {
                                    <li><i class="bi bi-dot me-1"></i>@phone.Number</li>
                                }
                            </ul>
                        </div>
                    }

                </div>
            </div>
        </div>
    }
</div>




