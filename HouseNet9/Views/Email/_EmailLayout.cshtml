@model HouseNet9.ViewModels.NewReservationEmailViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
</head>
<body style="font-family: Arial; background:#f5f5f5; padding:20px;">

<div style="max-width:700px;background:white;padding:30px;margin:auto;border-radius:8px;">

@if (!string.IsNullOrEmpty(Model.HouseLogoUrl))
{
    <img src="@Model.HouseLogoUrl" style="max-height:80px" />
}

<h2>@Model.MessageTitle</h2>

@RenderBody()

<hr />

<h3>Dane rezerwacji</h3>

<p><b>Numer rezerwacji:</b> @Model.ReservationNumber</p>
<p><b>Dom:</b> @Model.HouseName</p>
<p><b>Pobyt:</b> @Model.From.ToShortDateString() - @Model.To.ToShortDateString()</p>

<h3>Klient</h3>

<p>@Model.ClientFullName</p>
<p>@Model.ClientEmail</p>
<p>@Model.ClientPhone</p>

<hr />

<h3>Kontakt</h3>

@if (Model.Contacts != null)
{
    foreach (var contact in Model.Contacts)
    {
        <p><b>@contact.Name</b></p>

        if (contact.Emails != null)
        {
            foreach (var email in contact.Emails)
            {
                <p>Email: @email</p>
            }
        }

        if (contact.Phones != null)
        {
            foreach (var phone in contact.Phones)
            {
                <p>Telefon: @phone</p>
            }
        }
    }
}

</div>

</body>
</html>