@model Data.Data.HouseRentalData.DetailedInformation

@section Scripts {
    <script src="~/js/imagepreview.js"></script>
}




<div class="container">

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-sm mt-4">
                <div class="card-body">

                    <h3 class="mb-2">Informacje szczegółowe</h3>
                    <h5 class="text-muted mb-4">Zmiana nazwy</h5>

                    <div class="row">
                        <div class="col-12">
                            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <input type="hidden" asp-for="DetailedInformationId" />
                                <input type="hidden" name="ImagePath" value="@Model.Image?.Path" />

                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Grafika</label>
                                    <img id="preview"
                                         src="@Url.Content("~/uploads/" + (Model.Image == null ? "no_photography_24dp.svg" : Model.Image.Path))"
                                         alt="Podgląd obrazu"
                                         class="img-fluid mb-2" />
                                    <input type="file" name="file" id="fileInput" class="form-control" accept="image/*" />
                                </div>

                                <div class="mb-3">
                                    <input type="submit" value="Save" class="btn btn-primary w-100" />
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Wróć do listy</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


