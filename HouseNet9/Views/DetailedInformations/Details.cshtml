                       @*  bootstrap 5 *@

@model Data.Data.HouseRentalData.DetailedInformation
@using Data.Data.HouseRentalData

<h3>Informacje szczegółowe</h3>
<hr />

<div class="row mb-4">
    <!-- Lista istniejących elementów -->
    <div class="col-md-8 p-2">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <img src="@Url.Content("~/uploads/" + (Model.Image == null ? "no_photography_24dp.svg" : Model.Image.Path))" alt="Przesłany obraz" class="me-2" />
                @Html.DisplayFor(model => model.Name)
            </div>
            <ul class="list-group list-group-flush">
                @if (Model != null && Model.DetailedInformationItems != null)
                {
                    foreach (DetailedInformationItem item in Model.DetailedInformationItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @item.Description
                            <a asp-action="DeleteDetailedInformationItem"
                               asp-route-DetailedInformationId="@Model.DetailedInformationId"
                               asp-route-DetailedInformationItemId="@item.DetailedInformationItemId">
                                <img src="~/uploads/delete_forever_24.svg" class="ms-2" />
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <!-- Formularz dodawania -->
    <div class="col-md-4 p-2">
        <h4>Dodaj</h4>
        <hr />
        <form asp-action="CreateDetailedInformationItems">
            <input type="hidden" name="id" value="@Model.DetailedInformationId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <input name="description" type="text" class="form-control" placeholder="Opis" />
            </div>

            <div class="mb-3">
                <input type="submit" class="btn btn-primary w-100" value="Dodaj" />
            </div>
        </form>
    </div>

    <!-- Link do usuwania całego obiektu -->
    <div class="col-md-8 p-2 mt-3">
        <a class="nav-link text-danger d-flex align-items-center"
           asp-action="Delete"
           asp-route-id="@Model?.DetailedInformationId">
            <img src="~/uploads/delete_forever_24.svg" class="me-2" />Usuń @Model?.Name
        </a>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">Powrót do listy</a>


