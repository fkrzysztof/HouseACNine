@model IEnumerable<Data.Data.HouseRentalData.DetailedInformation>


<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Lista Rezerwacji</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Dodaj
    </a>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <img src="@Url.Content("~/uploads/" + (item.Image == null ? "no_photography_24dp.svg" : item.Image.Path))"
                             alt="Przesłany obraz"
                             class="img-thumbnail me-2"
                             style="width: 40px; height: 40px; object-fit: cover;" />
                        @Html.DisplayFor(modelItem => item.Name)
                    </div>
                    <div>
                        @await Html.PartialAsync("~/Views/Partial/EditDetailsMenu.cshtml", item.DetailedInformationId)
                    </div>
                </div>
            </div>
        </div>
    }
</div>

