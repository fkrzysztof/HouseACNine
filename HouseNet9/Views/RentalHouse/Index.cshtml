@model IEnumerable<Data.Data.HouseRentalData.RentalHouse>
@Html.AntiForgeryToken()
<script>
    const changeStatusUrl = '@Url.Action("ChangeStatusAjax", "RentalHouse")';
</script>
<script src="~/js/rentalhouse.js"></script>


<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Lista Rezerwacji</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Dodaj
    </a>
</div>

<div class="container mt-4">

    <!-- FILTRY -->
    <form method="get" class="row g-2 mb-3">

        <!-- Od -->
        <div class="col-md-3">
            <label for="fromDate" class="form-label">Od:</label>
            <input type="date"
                   name="fromDate"
                   id="fromDate"
                   class="form-control"
                   value="@ViewData["FromDate"]" />
        </div>

        <!-- Do -->
        <div class="col-md-3">
            <label for="toDate" class="form-label">Do:</label>
            <input type="date"
                   name="toDate"
                   id="toDate"
                   class="form-control"
                   value="@ViewData["ToDate"]" />
        </div>

        <!-- Wyszukiwanie klienta -->
        <div class="col-md-4">
            <label for="clientSearch" class="form-label">Klient:</label>
            <input type="text"
                   name="clientSearch"
                   id="clientSearch"
                   class="form-control"
                   placeholder="Wpisz imię lub nazwisko..."
                   value="@ViewData["ClientSearch"]" />
        </div>

        <!-- Przyciski -->
        <div class="col-md-2 align-self-end d-grid gap-2">
            <button type="submit" class="btn btn-primary">
                Filtruj
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Reset
            </a>
        </div>

    </form>

    <!-- TABELA -->
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
          @*   <th>Dom</th> *@
            <th>Klient</th>
            <th>Status</th>
            <th>Od</th>
            <th>Do</th>
            <th>Dni</th>
            <th>Do zapłaty</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
         @*        <td>@item.House?.Name</td> *@
                <td>@item.RentalClient?.FullName</td>


                    <td>
                        @{
                            // Funkcja mapująca status na kolor koła
                            Func<string, string> statusColor = name => name switch
                            {
                                "Zapłacono całość" => "green",
                                "Do zapłaty" => "yellow",
                                "Zaliczka" => "blue",
                                "Wynajem własny" => "black",
                                _ => "gray"
                            };

                            var color = statusColor(item.RentalStatus?.Name);
                            var statuses = ViewBag.Statuses as List<Data.Data.HouseRentalData.RentalStatus>;
                        }

                        @* Jeśli wynajem własny -> czarne kółko z napisem *@
                        @if (item.RentalStatus?.Name == "Wynajem własny")
                        {
                            <span class="badge bg-dark d-inline-flex align-items-center justify-content-center"
                                  style="width: 100%; min-width: 100px; padding: 0.5rem; font-size: 0.9rem;">
                                Wynajem własny
                            </span>
                            
                        }
                        else
                        {
                             <div class="d-flex align-items-center gap-2">
                            <!-- Koło jako wskaźnik statusu -->
                            <span style="
                    display:inline-block;
                    width:15px;
                    height:15px;
                    border-radius:50%;
                    background-color:@color;
                    border:none;
                "></span>

                            <!-- Select do zmiany statusu -->
@*                             <select class="form-select status-select" data-id="@item.RentalHouseID" style="width:auto;">
                                @foreach (var status in statuses)
                                {
                                    @Html.Raw($"<option value='{status.RentalStatusID}' {(item.RentalStatusID == status.RentalStatusID ? "selected='selected'" : "")}>{status.Name}</option>")
                                }
                            </select> *@

                            <select class="form-select status-select"
                                    data-id="@item.RentalHouseID"
                                    id="status_@item.RentalHouseID"
                                    name="status_@item.RentalHouseID"
                                    style="width:auto;">
                                @foreach (var status in statuses)
                                {
                                    @Html.Raw($"<option value='{status.RentalStatusID}' {(item.RentalStatusID == status.RentalStatusID ? "selected='selected'" : "")}>{status.Name}</option>")
                                }
                            </select>
                            </div>

                        }
                    </td>





                <td>@item.From.ToString("yyyy-MM-dd")</td>
                <td>@item.To.ToString("yyyy-MM-dd")</td>
                <td>@item.HowManyDaysFromSelect</td>
                <td>@item.ToPay.ToString("C")</td>
                <td>
                    <div class="d-flex gap-2">
                        <form asp-action="Delete" asp-route-id="@item.RentalHouseID" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger text-end"
                                    onclick="return confirm('Czy na pewno chcesz dezaktywować tę rezerwację?');">
                                Usuń
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>


    <h3 class="text-end">
        Suma: @((ViewData["SumPrice"] as decimal?)?.ToString("F2") ?? "0.00")
    </h3>

</div>

@section Scripts {
<script src="~/js/rentalhouse.js"></script>
}