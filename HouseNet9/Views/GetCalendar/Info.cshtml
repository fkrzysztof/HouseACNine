@using System.Globalization
@using Data.Data.HouseRentalData
@model Data.Data.HouseRentalData.RentalClient

@{
    RentalHouse newRental = ViewBag.NewRentalInfo;
}

@* <form asp-action="Create" method="post"> *@

<div class="row no-gutters">
    <!-- Wybrany termin -->
    <div class="col-12 p-2 align-content-between">
        <h6 class="mb-1">Wybrany termin:</h6>
        <p class="mb-0"><small>Od: @newRental.From.Date.ToString("D", CultureInfo.CreateSpecificCulture("pl-PL"))</small></p>
        <p class="mb-0"><small>Do: @newRental.To.Date.ToString("D", CultureInfo.CreateSpecificCulture("pl-PL"))</small></p>
        <p class="mb-0"><small>@newRental.HowManyDaysFromSelect Nocy</small></p>
    </div>

    <!-- Do zapłaty -->
    <div class="col-sm-12 p-2 text-sm-left">
        <h6 class="mb-1">Do zapłaty:</h6>
        <p class="mb-0 fw-bold">@newRental.ToPay.ToString("C", CultureInfo.CurrentCulture)</p>
        <small class="d-block">Cena zawiera sprzątanie końcowe</small>
        <small class="d-block">Cena zawiera pościel oraz ręczniki</small>
    </div>

    <!-- Checkboxy -->
    <div class="col-sm-12 p-2 text-sm-right">
        <div class="form-check mb-1 text-left">
            <input class="form-check-input check-color" type="checkbox" id="check1">
            <label class="form-check-label" for="check1"><small>Podane przeze mnie informacje są prawdziwe.</small></label>
        </div>
        <div class="form-check mb-1 text-left">
            <input class="form-check-input check-color" type="checkbox" id="check2">
            <label class="form-check-label" for="check2"><small>Akceptuję warunki i politykę prywatności.</small></label>
        </div>
        <div class="form-check mb-1 text-left">
            <input class="form-check-input check-color" type="checkbox" id="check3">
            <label class="form-check-label" for="check3"><small>Potwierdzam, że mam min. 18 lat.</small></label>
        </div>
    </div>

    <!-- Przyciski -->
    <div class="col-sm-12 p-2 text-sm-right">
        <button type="button" class="btn btn-secondary btn-sm" id="btnClose">Close</button>
        <a asp-action="Create" class="btn btn-primary btn-sm" id="btnCreate">Kontynuuj rezerwację</a>
    </div>
</div>

@* <p>@Url.Action("Create", "GetCalendar")</p> tu *@


<script src="~/js/agreement.js" asp-append-version="true"></script>

