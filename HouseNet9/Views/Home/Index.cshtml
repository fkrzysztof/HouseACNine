@using Data.Data.HouseRentalData
@model Data.Data.HouseRentalData.House


@* *************************  GeneralInformation ************************* *@
<section id="generalinformationanchor">
    <div class="container">
        <div class="d-flex flex-wrap bd-highlight justify-content-center my-4">
            @{
                if (Model != null && Model.GeneralInformation != null)
                    foreach (GeneralInformation item in Model.GeneralInformation)
                    {
                        @:<div class="card p-2 p-lg-4 m-2 d-inline justify-content-center">
                            if (item.Image != null && item.Image.Path != null)
                            {
                                    <img src="@Url.Content("~/uploads/" + item.Image.Path)" alt="Przesłany obraz" />
                                    @Html.DisplayFor(modelItem => item.Name)
                            }
                            else
                            {
                                    <img src="@Url.Content("~/uploads/" + "no_photography_24dp.svg")" alt="Przesłany obraz" />
                                    @Html.DisplayFor(modelItem => item.Name)
                            }
                        @:</div>
                    }
            }
        </div>
    </div>
</section>



@* ******************************** Calendar ******************************** *@
<section id="calendaranchor">


    <div class="container mt-5">

        <h2 class="section-divider">
            <span>Rezerwacja on-line</span>
        </h2>

        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

            <!-- Przycisk poprzedni miesiąc -->
            <button id="prevBtn" class="button-as-link">
                <i class="bi bi-chevron-left"></i>
            </button>

            <!-- Slider wyboru tygodni w centrum -->
            <div id="weeksSliderWrapper" class="d-flex flex-column align-items-center mx-3">
                <div class="slider-title mb-2 text-muted small fw-semibold">Wybierz ilość tygodni</div>
                <input type="range" id="weeksSlider" min="1" max="3" step="1" value="1">
                <div class="slider-labels d-flex justify-content-between w-100 mt-1 px-2">
                    <span class="mt-2">1</span>
                    <span class="mt-2">2</span>
                    <span class="mt-2">3</span>
                </div>
            </div>

            <!-- Przycisk następny miesiąc -->
            <button id="nextBtn" class="button-as-link">
                <i class="bi bi-chevron-right"></i>
            </button>

        </div>

        <div id="calendarWrapper" class="row py-4 g-4"></div>

        @* *************** info div **************** *@
        <div id="selectedRange" class="card border-0 shadow-sm d-none my-5" style="border-radius: 14px;">
            <div class="card-body p-5">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 fw-semibold">
                        Podsumowanie rezerwacji
                    </h5>
                    <span class="badge bg-light text-dark px-3 py-2">
                        Krok 1 z 2
                    </span>
                </div>

                <hr class="mb-4">

                <div class="mb-4">
                    <div class="text-muted small mb-1">Termin pobytu</div>
                    <div class="fs-5 fw-semibold">
                        <span id="resStart"></span> – <span id="resEnd"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="text-muted small mb-1">Ilość noclegów</div>
                        <div class="fw-semibold">
                            <span id="resDays"></span>
                        </div>
                    </div>

                    <div class="col-md-6 text-md-end">
                        <div class="text-muted small mb-1">Cena całkowita</div>
                        <div class="fs-4 fw-bold">
                            <span id="resPrice"></span> PLN
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top text-end">
                    <button id="btnContinue" class="btn btn-dark px-5 py-2">
                        Kontynuuj rezerwację
                    </button>
                </div>

            </div>
        </div>


    </div>
</section>

<section>
    <div class="container">

        <div class="row gx-0 mb-4 mb-lg-5 align-items-center">
            <div class="col-xl-8 col-lg-7">

                <video src="~/video/compressed_cro-dron-short2-hq-ok.webm" type="audio/webm"
                       autoplay
                       loop
                       muted
                       playsinline
                       style="width: 100%; height: auto; border-radius: 8px;">
                </video>

            </div>
            @* Opis przy VIDEO DOMU *@
            <div class="col-xl-4 col-lg-5">
                <div class="featured-text text-start text-lg-left m-4">
                    <h4>@Model.Name</h4>
                    <p class="text-black-50 mb-0">@Model.LongText</p>
                </div>
            </div>
        </div>
    </div>
</section>


@* *************************  DescriptionPages *************************  *@
<section class="py-4" id="descriptionpagesanchor">
        <!-- Featured Project Row-->
        <!-- Project One Row-->
        @{
            bool xy = true;

            if (Model != null && Model.DescriptionPages != null)
                foreach (DescriptionPage descriptionPage in Model.DescriptionPages)
                {
                    <div class="desc-page-section section-triangle">

                        <div class="container" id="@descriptionPage.Title">

                        <h2 class="section-divider">

                            <button class="section-accordion-btn"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse-@descriptionPage.DescriptionPageId"
                                    aria-expanded="false">

                            <span>@descriptionPage.Title</span>

                                <i class="bi bi-chevron-down section-accordion-icon"></i>

                            </button>

                        </h2>


                        </div>
                    <div class="collapse show show-desktop-only" id="collapse-@descriptionPage.DescriptionPageId">
                        <div class="container px-4 px-lg-5">
                            <div class="row gx-3 my-5 mb-lg-0 justify-content-center">

                                <!-- *********** col-6 I PHOTO -->

                                @{
                                    var images = descriptionPage.Images?.Take(12).ToList() ?? new List<MyFile>();
                                    bool hasImages = images.Any();

                                    int i = 0;
                                    xy = !xy;
                                }

                                @if(hasImages)
                                   {
                                        <div class="col-lg-6 @(xy ? "order-lg-first" : "order-lg-last")">

                                            <div class="photo-masonry">

                                                @{
                                                //     var images = descriptionPage.Images?.Take(12).ToList() ?? new List<MyFile>();
                                                //     int i = 0;
                                                //     xy = !xy;
                                                }

                                                @foreach (var img in images)
                                                {
                                                    i++;

                                                    var isVerticalSlot = (i % 5 == 0);

                                                    <div class="masonry-item @(isVerticalSlot ? "vertical-force" : "")">
                                                        <img src="@Url.Content("~/uploads/" + (img == null ? "no_photography_24dp.svg" : img.Path))" />
                                                    </div>
                                                }

                                            </div>
                                        </div>
                                   }
                                    <!-- *********** col-6 II -->
                                <div class="@(hasImages ? "col-lg-6" : "col-12") margin-b">
                                    <div class="bg-black text-center h-100 project desc-page-textbox">
                                        <div class="">
                                            <div class="project-text w-100 my-auto text-center text-lg-left">


                                                @using System.Text.RegularExpressions

                                                @if (!string.IsNullOrEmpty(descriptionPage.Description))
                                                {
                                                    var text = descriptionPage.Description
                                                        .Replace("\r\n", "\n")
                                                        .Replace("\r", "\n");

                                                    var paragraphs = Regex.Split(text, @"\n{2,}");

                                                    foreach (var paragraph in paragraphs)
                                                    {
                                                        <p class="mb-3 text-start">@paragraph.Trim()</p>
                                                    }
                                                }

                                            </div>
                                            <a class="" asp-area="" asp-controller="Home" asp-action="More" asp-route-id="@descriptionPage.DescriptionPageId" asp-route-houseId="@Model.HouseId">więcej >></a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            </div>
                        </div>
                    </div>
                }
        }


</section>




@* ----------------- Detailed Information -----------------*@
<section id="detailedanchor">
    <div class="container">

<h2 class="section-divider">

    <button class="section-accordion-btn"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#detailsCollapse"
            aria-expanded="false">

        <span>Szczegółowe informacje</span>

        <i class="bi bi-chevron-down section-accordion-icon"></i>

    </button>

</h2>

        <div class="collapse show show-desktop-only"
             id="detailsCollapse">



        @if (Model.DetailedInformation != null && Model.DetailedInformation.Count > 0)
        {
            <div class="row my-4">
                <div class="col-12 px-0">
                    <div class="card-columns-css">
                        @foreach (DetailedInformation information in Model.DetailedInformation)
                        {
                            <div class="card card-2-border p-4">
                                <div class="card-body">
                                    <h5 class="card-title d-flex align-items-center">
                                        <img class="icon icon-lg icon-left icon-hover" src="@Url.Content("~/uploads/" + (information.Image?.Path ?? "no_photography_24dp.svg"))" alt="@information.Name" />
                                        @information.Name
                                    </h5>
                                    @if(information.DetailedInformationItems != null && information.DetailedInformationItems.Any())
                                    foreach (DetailedInformationItem item in information.DetailedInformationItems)
                                    {
                                        <div class="d-flex align-items-center">
                                            <img src="~/uploads/check_24dp.svg" class="icon icon-sm icon-left icon-success" />
                                            @item.Description
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>


            </div>

</section>


@* *************************  Distance ************************* *@   
<section id="distanceanchor">
        <div class="container">

<h2 class="section-divider">

    <button class="section-accordion-btn"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#distanceCollapse"
            aria-expanded="false">

        <span>Odległości</span>

        <i class="bi bi-chevron-down section-accordion-icon"></i>

    </button>

</h2>

            <div class="collapse show show-desktop-only"
                 id="distanceCollapse">



                <div class="row  my-4">
                    <div class="col-12">
                        <div class="card-columns-css">
                            @foreach (Distance distance in Model.Distances)
                            {
                                <div class="card card-2-border p-4">
                                    @* class="card" *@
                                    <div class="card-body">
                                        <h5 class="card-title d-flex align-items-center"> <img class="mr-2" src="@Url.Content("~/uploads/" + (distance.Image == null ? "no_photography_24dp.svg" : distance.Image.Path))" alt="Przesłany obraz" />@distance.Name</h5>

                                        @{
                                            if (distance != null && distance.DistanceItems != null)
                                                foreach (DistanceItem item in distance.DistanceItems)
                                                {
                                                    <div class="d-flex justify-content-between"><span>@item.NameInfo</span><span>@item.DistanceInfo</span></div>
                                                }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>


        </div>



</section>






<script>
    const houseId = @(Model.HouseId);
</script>

@section Scripts {

<script src="~/js/calendarGenerate4.js" asp-append-version="true"></script>

<script>
            const weeksSlider = document.getElementById('weeksSlider');
        weeksSlider.addEventListener('input', function() {
            const selectedWeeks = this.value;
            renderCalendar(selectedWeeks);
        });
</script>





}