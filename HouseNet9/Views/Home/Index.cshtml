            <div class="col-xl-8 col-lg-7">

                <video src="~/video/compressed_cro-dron-short2-hq-ok.webm" type="audio/webm"
                       autoplay
                       loop
                       muted
                       playsinline
                       style="width: 100%; height: auto; border-radius: 8px;">
                </video>

            </div>
            @* Opis przy VIDEO DOMU *@
            <div class="col-xl-4 col-lg-5">
                <div class="featured-text text-center text-lg-left">
                    <h4>@Model.Name</h4>
                    <p class="text-black-50 mb-0">@Model.LongText</p>
                </div>
            </div>
        </div>
        <!-- Project One Row-->
        @{
            bool xy = true;
