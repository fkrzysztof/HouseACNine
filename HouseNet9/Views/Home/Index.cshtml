@using Data.Data.HouseRentalData
@model Data.Data.HouseRentalData.House


@* *************************  GeneralInformation ************************* *@
<section id="generalinformationanchor">
<div class="d-flex flex-wrap bd-highlight justify-content-center my-4">
    @{
        if (Model != null && Model.GeneralInformation != null)
            foreach (GeneralInformation item in Model.GeneralInformation)
            {
                @:<div class="card p-4 m-2 d-inline justify-content-center">
                    if (item.Image != null && item.Image.Path != null)
                    {
                            <img src="@Url.Content("~/uploads/" + item.Image.Path)" alt="Przesłany obraz" />
                            @Html.DisplayFor(modelItem => item.Name)
                    }
                    else
                    {
                            <img src="@Url.Content("~/uploads/" + "no_photography_24dp.svg")" alt="Przesłany obraz" />
                            @Html.DisplayFor(modelItem => item.Name)
                    }
                @:</div>
            }
    }
</div>
</section>

@* ******************************** Calendar ******************************** *@
<section id="calendaranchor">


    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

            <!-- Przycisk poprzedni miesiąc -->
            <button id="prevBtn" class="button-as-link">
                <i class="bi bi-chevron-left"></i>
            </button>

            <!-- Slider wyboru tygodni w centrum -->
            <div id="weeksSliderWrapper" class="d-flex flex-column align-items-center mx-3">
                <div class="slider-title mb-2 text-muted small fw-semibold">Wybierz ilość tygodni</div>
                <input type="range" id="weeksSlider" min="1" max="3" step="1" value="1">
                <div class="slider-labels d-flex justify-content-between w-100 mt-1 px-2">
                    <span class="mt-2">1</span>
                    <span class="mt-2">2</span>
                    <span class="mt-2">3</span>
                </div>
            </div>

            <!-- Przycisk następny miesiąc -->
            <button id="nextBtn" class="button-as-link">
                <i class="bi bi-chevron-right"></i>
            </button>

        </div>

        <div id="calendarWrapper" class="row py-4 g-4"></div>

        @* *************** info div **************** *@
        <div id="selectedRange" class="card border-0 shadow-sm d-none my-5" style="border-radius: 14px;">
            <div class="card-body p-5">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 fw-semibold">
                        Podsumowanie rezerwacji
                    </h5>
                    <span class="badge bg-light text-dark px-3 py-2">
                        Krok 1 z 2
                    </span>
                </div>

                <hr class="mb-4">

                <div class="mb-4">
                    <div class="text-muted small mb-1">Termin pobytu</div>
                    <div class="fs-5 fw-semibold">
                        <span id="resStart"></span> – <span id="resEnd"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="text-muted small mb-1">Ilość noclegów</div>
                        <div class="fw-semibold">
                            <span id="resDays"></span>
                        </div>
                    </div>

                    <div class="col-md-6 text-md-end">
                        <div class="text-muted small mb-1">Cena całkowita</div>
                        <div class="fs-4 fw-bold">
                            <span id="resPrice"></span> PLN
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top text-end">
                    <button id="btnContinue" class="btn btn-dark px-5 py-2">
                        Kontynuuj rezerwację
                    </button>
                </div>

            </div>
        </div>


    </div>
</section>


@* *************************  DescriptionPages ************************* *@
