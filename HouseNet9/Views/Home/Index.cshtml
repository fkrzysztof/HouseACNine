@using Data.Data.HouseRentalData
@* @{ ViewData["Title"] = "Home Page"; } *@
@model Data.Data.HouseRentalData.House

@* ******************************** Calendar ******************************** *@
<div class="container">

    <div class="d-flex justify-content-between mb-3">
        <button id="prevBtn" class="button-as-link"><i class="bi bi-chevron-left"></i></button>
        <div>
           @*  <label class="form-label">Długość rezerwacji:</label> *@
            <select id="weeksSelect" class="form-select w-auto d-inline-block ms-2">
                <option value="1">1 tydzień</option>
                <option value="2">2 tygodnie</option>
                <option value="3">3 tygodnie</option>
            </select>
        </div>
        <button id="nextBtn" class="button-as-link"><i class="bi bi-chevron-right"></i></button>
    </div>

    <div id="calendarWrapper" class="row py-4 g-4"></div>
    <div id="selectedRange" class="alert alert-info d-none mt-3"></div>

</div>

@* ******************************** END  Calendar ******************************** *@

@* *************************  DescriptionPages ************************* *@

    <section class="projects-section bg-light" id="projects">
        <div class="container px-4 px-lg-5">
            <!-- Featured Project Row-->
            <div class="row gx-0 mb-4 mb-lg-5 align-items-center">
                <div class="col-xl-8 col-lg-7">

                <video src="~/video/compressed_cro-dron-short2-hq-ok.webm" type="audio/webm"
                       autoplay
                       loop
                       muted
                       playsinline
                       style="width: 100%; height: auto; border-radius: 8px;">
                </video>
                    
                </div>
                <div class="col-xl-4 col-lg-5">
                    <div class="featured-text text-center text-lg-left">
                        <h4>Shoreline</h4>
                        <p class="text-black-50 mb-0">Grayscale is open source and MIT licensed. This means you can use it for any project - even commercial projects! Download it, customize it, and publish your website!</p>
                    </div>
                </div>
            </div>
            <!-- Project One Row-->
        @{
            bool xy = true;
            int count = 0;
            if(Model != null && Model.DescriptionPages != null)
                foreach( DescriptionPage descriptionPage in Model.DescriptionPages)
                {
                    <div class="row gx-0 mb-5 mb-lg-0 justify-content-center">
                    <div class="col-lg-6 @(xy == true ? "order-first":"order-last") ">
                        @foreach(MyFile img in descriptionPage.Images.Take(2))
                        {
                            <img class="circle-foto" src="@Url.Content("~/uploads/" + (img == null ? "no_photography_24dp.svg" : img.Path))" alt="..." />    
                        }
                    </div>
                      
                        <div class="col-lg-6">
                            <div class="bg-black text-center h-100 project">
                                <div class=""> 
                                    <div class="project-text w-100 my-auto text-center text-lg-left">
                                        <h4 class="text-white">@descriptionPage.Title</h4>
                                        <p class="mb-0 text-white-50">@descriptionPage.Description</p>
                                    </div>

                                    @if(count == 0)
                                    {
                                        @* *************************  GeneralInformation ************************* *@
                                        // <div class="d-flex flex-wrap justify-content-center my-4">
                                        //     @{
                                        //         if (Model != null && Model.GeneralInformation != null)
                                        //             foreach (GeneralInformation item in Model.GeneralInformation)
                                        //             {
                                        //                 // @:<div class="card p-4 m-2 d-inline justify-content-center">
                                        //                 @:<div class="card p-4 m-2 justify-content-center">
                                        //                     if (item.Image != null && item.Image.Path != null)
                                        //                     {
                                        //                             <img src="@Url.Content("~/uploads/" + item.Image.Path)" alt="Przesłany obraz" />
                                        //                             @Html.DisplayFor(modelItem => item.Name)
                                        //                     }
                                        //                     else
                                        //                     {
                                        //                             <img src="@Url.Content("~/uploads/" + "no_photography_24dp.svg")" alt="Przesłany obraz" />
                                        //                             @Html.DisplayFor(modelItem => item.Name)
                                        //                     }
                                        //                 @:</div>
                                        //             }
                                        //     }
                                        // </div>
                                        }

                                    <a class="" asp-area="" asp-controller="Home" asp-action="More" asp-route-id="@descriptionPage.DescriptionPageId" asp-route-houseId="@Model.HouseId">więcej >></a>
                                </div>
                            </div>
                        </div>
                    </div>
                    xy = !xy;
                    count++;


                }
            }
        </div>
    </section>












