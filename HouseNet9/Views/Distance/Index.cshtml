@model IEnumerable<Data.Data.HouseRentalData.Distance>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Odległości</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Dodaj
    </a>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-12 col-md-6 col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div class="d-flex align-items-center gap-3">
                        <img src="@Url.Content("~/uploads/" +
                                                         (item.Image == null
                                                             ? "no_photography_24dp.svg"
                                                             : item.Image.Path))"
                         alt="Przesłany obraz"
                         class="img-fluid"
                         style="max-height:60px;" />

                        <span class="fw-semibold">
                            @Html.DisplayFor(modelItem => item.Name)
                        </span>
                    </div>

                    <div>
                        @await Html.PartialAsync("~/Views/Partial/EditDetailsMenu.cshtml", item.DistanceID)
                    </div>

                </div>
            </div>
        </div>
        }
</div>
