@model IEnumerable<Data.Data.HouseRentalData.DescriptionPage>

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Opis strony</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Dodaj
    </a>
</div>

<div id="pages-list" class="row g-4" data-delete-url="@Url.Action("DeleteItem", "DescriptionPages")">
    @foreach (var item in Model)
    {
        <div class="col-12 col-md-6 col-lg-4 page-item" data-id="@item.DescriptionPageId">
            <div class="card h-100 shadow-sm">

                <!-- CARD HEADER -->
                <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <h5 class="mb-2 mb-md-0 text-truncate" title="@item.Title">@item.Title</h5>
                    <div class="btn-group flex-wrap" role="group">
                        <!-- Pełny przycisk Edytuj -->
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary mb-2 mb-md-0 me-0 me-md-1"
                                onclick="location.href='@Url.Action("Edit", new { id = item.DescriptionPageId })'">
                            <i class="bi bi-pencil-square me-1"></i> Edytuj
                        </button>
                        <!-- Pełny przycisk Usuń -->
                        <button type="button"
                                class="btn btn-sm btn-outline-danger delete-page"
                                data-id="@item.DescriptionPageId">
                            <i class="bi bi-trash-fill me-1"></i> Usuń
                        </button>
                    </div>
                </div>

                <!-- CARD BODY -->
                <div class="card-body d-flex flex-column">
                    <!-- GALERIA ZDJĘĆ -->
                    <div class="image-gallery mb-3">
                        @if (item.Images != null && item.Images.Any())
                        {
                            foreach (var image in item.Images)
                            {
                                <div class="image-item">
                                    <img src="@Url.Content("~/uploads/" + image.Path)" alt="Zdjęcie" />
                                </div>
                            }
                        }
                        else
                        {
                            <div class="image-item">
                                <img src="@Url.Content("~/uploads/no_photography_24dp.svg")" alt="Brak zdjęcia" />
                            </div>
                        }
                    </div>

                    <!-- OPIS -->
                    <p class="card-text">@Html.DisplayFor(modelItem => item.Description)</p>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/descriptionpage-list.css" />
}

@section Scripts {
    <script src="~/js/deletepage.js"></script>
}