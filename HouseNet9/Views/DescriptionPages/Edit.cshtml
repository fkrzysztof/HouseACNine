@model Data.Data.HouseRentalData.DescriptionPage

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div class="row">
        <!-- LEWA CZĘŚĆ FORMULARZA -->
        <div class="col-lg-9">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="DescriptionPageId" />

            <!-- Tytuł -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Opis -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="10"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <hr />

            <!-- Aktualne zdjęcia -->
            <div class="mb-3">
                <label class="form-label">Aktualne zdjęcia</label>

                <div id="images-container" data-delete-url="@Url.Action("DeleteImage", "DescriptionPages")">
                    @if (Model.Images != null && Model.Images.Count > 0)
                    {
                        @foreach (var img in Model.Images.OrderBy(x => x.Order))
                        {
                            <div class="image-item position-relative" data-id="@img.FileID">
                                <div class="drag-handle text-center mb-1" style="cursor: grab;">☰</div>
                                <img src="~/uploads/@img.Path" class="img-thumbnail w-100 mb-1" />
                                <button type="button" class="btn btn-danger btn-sm w-100 remove-image">Usuń</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p><i>Brak zdjęć</i></p>
                    }
                </div>
            </div>
        </div>

        <!-- PRAWA CZĘŚĆ – Dodawanie nowych zdjęć -->
        <div class="col-lg-3">
            <div class="mb-3">
                <label class="form-label">Dodaj nowe zdjęcia</label>
                <img id="preview" src="~/uploads/noimg.png" alt="Podgląd obrazu" class="img-fluid mb-2">
                <input type="file" name="files" id="fileInput" accept="image/*" multiple class="form-control" />
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary w-100">Save</button>
            </div>
        </div>
    </div>
</form>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>


@section Styles {
    <link rel="stylesheet" href="~/css/descriptionpage.css" />
}

@section Scripts {
    <script src="~/js/imagepreview.js"></script>
    <script src="~/js/imagedelete.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="~/js/imageorder.js"></script>
}