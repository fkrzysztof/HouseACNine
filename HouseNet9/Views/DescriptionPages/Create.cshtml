@model Data.Data.HouseRentalData.DescriptionPage

@section Scripts {
    <script src="~/js/imagepreview.js"></script>
}

<h4><img src="~/uploads/add_notes.svg" class="me-2" />Dodaj opis do strony</h4>
<hr />
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col-lg-9">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">@Html.DisplayFor(Model => Model.Description)</label>
                <textarea class="form-control" asp-for="Description" rows="10"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            @* Dodatkowe info *@
            <div class="mb-3">
                <label class="form-label">Sekcje</label>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedSections" value="General" id="secGeneral">
                    <label class="form-check-label" for="secGeneral">Główne informacje</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedSections" value="Detailed" id="secDetailed">
                    <label class="form-check-label" for="secDetailed">Szczegółowe informacje</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedSections" value="Distance" id="secDistance">
                    <label class="form-check-label" for="secDistance">Odległości</label>
                </div>
            </div>

        </div>

        <div class="col-lg-3 d-flex flex-column">

            <div class="mb-3">
                <label class="form-label">Grafika</label>
                <img id="preview" src="~/uploads/noimg.png" alt="Podgląd obrazu" class="img-fluid mb-2">
                <input type="file" name="files" id="fileInput" multiple accept="image/*" class="form-control" />
            </div>

            <div class="mt-auto">
                <input type="submit" value="Create" class="btn btn-primary w-100" />
            </div>

        </div>
    </div>
</form>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
