@model Data.Data.HouseRentalData.SiteSettings

@{
    ViewData["Title"] = "Edycja ustawień strony";
}

@section Scripts {
    <script src="~/js/siteSettingsQuill.js"></script>
}

<div class="container py-5">

    <h1 class="mb-4">
        Ustawienia strony
    </h1>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">
            Zapisano zmiany.
        </div>
    }

    <form id="siteSettingsEditForm" asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-5">

            <label class="form-label fw-bold">
                Polityka prywatności
            </label>

            <div id="privacyEditor"
                 style="height: 500px; background-color: #fff;">
                @Html.Raw(Model.PrivacyPolicy)
            </div>

            <input type="hidden"
                   name="PrivacyPolicy" />

        </div>


        <div class="mb-5">

            <label class="form-label fw-bold">
                Polityka Cookies
            </label>

            <div id="cookiesEditor"
                 style="height: 400px; background-color: #fff;">
                @Html.Raw(Model.CookiesPolicy)
            </div>

            <input type="hidden"
                   name="CookiesPolicy" />

        </div>


        <button type="submit"
                class="btn btn-dark px-5">
            Zapisz
        </button>

    </form>

</div>