@model Data.Data.HouseRentalData.GeneralInformation

@section Scripts {
    <script src="~/js/imagepreview.js"></script>
}

<div class="container">

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-sm mt-4">
                <div class="card-body">

                    <h3 class="mb-2">Informacje szczegółowe</h3>
                    <h5 class="text-muted mb-4">Zmiana nazwy</h5>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="GeneralInformationId" />
                        <input type="hidden" name="ImagePath" value="@Model.Image?.Path" />

                        <!-- Nazwa -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Grafika -->
                        <div class="mb-4">
                            <label class="form-label">Grafika</label>

                            <div class="text-center mb-3">
                                <img id="preview"
                                     src="@Url.Content("~/uploads/" +
                                                                              (Model.Image == null
                                                                                  ? "no_photography_24dp.svg"
                                                                                  : Model.Image.Path))"
                                     alt="Podgląd obrazu"
                                     class="img-fluid rounded border"
                                     style="max-height:200px;" />
                            </div>

                            <input type="file"
                                   name="file"
                                   id="fileInput"
                                   accept="image/*"
                                   class="form-control" />
                        </div>

                        <!-- Przyciski -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Wróć do listy
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Zapisz
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
