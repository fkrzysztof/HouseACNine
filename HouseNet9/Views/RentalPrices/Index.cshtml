@model Data.Data.HouseRentalData.RentalPrice
@using Data.Data.HouseRentalData

@{
    var list = ViewBag.List as List<RentalPrice>;
}

<div class="row">

    <!-- LISTA -->
    <div class="col-lg-8">

        @if (list != null && list.Any())
        {
            foreach (var item in list)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-9">
                                <strong>
                                    @item.DateTimeFrom?.ToShortDateString()
                                    -
                                    @item.DateTimeTo?.ToShortDateString()
                                </strong>

                                <p class="mb-1">
                                    1 tydzień: <b>@item.OneWeek zł</b>
                                </p>
                                <p class="mb-0">
                                    2 tygodnie: <b>@item.TwoWeeks zł</b>
                                </p>
                            </div>

                            <div class="col-3 text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@item.RentalPriceID"
                                   class="btn btn-sm btn-warning">
                                    Edytuj
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.RentalPriceID"
                                   class="btn btn-sm btn-danger">
                                    Usuń
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                Brak cen dla tego domu.
            </div>
        }

    </div>

    <!-- CREATE -->
    <div class="col-lg-4">

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Dodaj nową cenę</h5>
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">

                    <input type="hidden" asp-for="HouseId" />

                    <div class="mb-3">
                        <label asp-for="OneWeek" class="form-label"></label>
                        <input asp-for="OneWeek"
                               type="number"
                               step="0.01"
                               class="form-control" />
                        <span asp-validation-for="OneWeek" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TwoWeeks" class="form-label"></label>
                        <input asp-for="TwoWeeks"
                               type="number"
                               step="0.01"
                               class="form-control" />
                        <span asp-validation-for="TwoWeeks" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DateTimeFrom" class="form-label"></label>
                        <input asp-for="DateTimeFrom"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="DateTimeTo" class="form-label"></label>
                        <input asp-for="DateTimeTo"
                               type="date"
                               class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        Zapisz
                    </button>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
